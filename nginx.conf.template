server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Reverse-proxy to the backend so the browser calls same-origin /api/*
    # (avoids CORS). BACKEND_ORIGIN is substituted at container startup
    # (see docker-entrypoint.d/20-envsubst-on-templates.sh in the nginx image):
    # local Docker Compose -> host.docker.internal:3000, Render -> the
    # backend service's internal URL, set via each environment's env vars.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        # BACKEND_ORIGIN may be an https:// host behind SNI-based routing
        # (e.g. Render, Cloudflare) - proxy_ssl_server_name sends the right
        # SNI, and $proxy_host (the host:port from proxy_pass, not the
        # incoming request) sends the Host header the upstream expects.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Also proxied same-origin, for the same reason as /api/ above — plus a
    # second one that matters specifically here: onrender.com is on the
    # Public Suffix List, so this frontend and the backend are different
    # *sites*, not just different origins. A cookie set via a cross-site
    # fetch() to the backend directly is a third-party cookie and can be
    # silently dropped by the browser's tracking protections; proxied through
    # here, the browser only ever sees this frontend's own origin, so the
    # esignet_oauth/session cookies are first-party the whole time.
    # redirect_uri must be set to this frontend's own origin + /auth/callback
    # (VITE_ESIGNET_REDIRECT_URI / ESIGNET_REDIRECT_URI) for this to apply —
    # eSignet's browser redirect lands here, not on the backend directly.
    location /auth/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: routes like /callback don't exist as files,
    # they're handled client-side after the esignet redirect.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
