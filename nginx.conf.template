server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Reverse-proxy to the backend so the browser calls same-origin /api/*
    # (avoids CORS). BACKEND_ORIGIN is substituted at container startup
    # (see docker-entrypoint.d/20-envsubst-on-templates.sh in the nginx image):
    # local Docker Compose -> host.docker.internal:3000, Render -> the
    # backend service's internal URL, set via each environment's env vars.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        # BACKEND_ORIGIN may be an https:// host behind SNI-based routing
        # (e.g. Render, Cloudflare) - proxy_ssl_server_name sends the right
        # SNI, and $proxy_host (the host:port from proxy_pass, not the
        # incoming request) sends the Host header the upstream expects.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: routes like /callback don't exist as files,
    # they're handled client-side after the esignet redirect.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
