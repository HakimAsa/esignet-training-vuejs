VITE_ESIGNET_CLIENT_ID=
VITE_ESIGNET_REDIRECT_URI=https://esignet-backend.onrender.com/auth/callback
VITE_ESIGNET_AUTHORIZE_URI=https://esignet.benin.mosip.net/authorize
VITE_ESIGNET_SCOPE=openid profile
VITE_ESIGNET_ACR_VALUES=
# Leave empty for local dev/Docker Compose (uses the same-origin /api proxy).
# Set to the backend's full origin (e.g. https://esignet-backend.onrender.com)
# when the frontend and backend are deployed as separate services with no
# proxy between them, such as on Render.
VITE_API_BASE_URL=
