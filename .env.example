VITE_ESIGNET_CLIENT_ID=
# Must be THIS frontend's own origin + /auth/callback, not the backend's —
# nginx proxies /auth/* to the backend server-side (see nginx.conf.template).
# Required so the OAuth cookie stays first-party: onrender.com is on the
# Public Suffix List, so this frontend and the backend are different *sites*,
# and a cookie set via a direct cross-site call to the backend is
# third-party and can be dropped by the browser's tracking protections.
VITE_ESIGNET_REDIRECT_URI=https://vue-upload-form.onrender.com/auth/callback
VITE_ESIGNET_AUTHORIZE_URI=https://esignet.benin.mosip.net/authorize
VITE_ESIGNET_SCOPE=openid profile
VITE_ESIGNET_ACR_VALUES=
# Leave empty: nginx proxies both /api/* and /auth/* to the backend
# same-origin (see nginx.conf.template / nginx.conf), so relative paths work
# both locally and on Render — no cross-site call to the backend needed.
VITE_API_BASE_URL=
